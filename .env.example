# Copy this file to backend/.env and fill in real values.
# The application refuses to start without JWT_SECRET.

NODE_ENV=development
PORT=5001

# Signing key for JWTs. Use a long random string; rotating it invalidates all
# issued tokens. Never commit the real value.
JWT_SECRET=
# Access tokens are deliberately short-lived: they cannot be revoked before they
# expire. Sessions are kept alive by the refresh token instead.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# Window in which re-presenting a just-consumed refresh token counts as two
# tabs racing rather than a stolen credential. Keep it small.
REFRESH_REUSE_GRACE_MS=30000

# The refresh token is delivered as an httpOnly cookie.
# COOKIE_SECURE must be true anywhere the site is served over HTTPS; it
# defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# strict is correct when the API and the frontend share a site. If they are on
# different sites you need `none` (which also requires COOKIE_SECURE=true) and
# the frontend origin listed in CORS_ORIGINS.
COOKIE_SAME_SITE=strict
# COOKIE_DOMAIN=

# Set to false only for load testing. Leave on in every real environment.
RATE_LIMIT_ENABLED=true

# Loan reminders: how often overdue loans are marked and reminders sent
# (minutes, 0 = off), how many days before the due date the one "due soon"
# reminder goes out, and how often an overdue loan is reminded again.
# LOAN_REMINDER_INTERVAL_MINUTES=60
# LOAN_DUE_SOON_DAYS=1
# OVERDUE_REMINDER_REPEAT_DAYS=7

# Password for the sample members created by `npm run seed:overdue`. Leave unset
# to give them a random password nobody knows.
# SEED_MEMBER_PASSWORD=

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=library_db
# The schema is owned by migrations, which run automatically at startup.
# DB_MIGRATIONS_RUN=true
# Escape hatch only — leave off, or it will fight the migrations.
# DB_SYNCHRONIZE=false
# DB_LOGGING=false

# Schema used by `npm run test:e2e`. Dropped and recreated on every run, so it
# must never point at a database you care about.
E2E_DB_NAME=library_e2e_db

# Comma-separated list of browser origins allowed to call this API.
# The dev server port is set in frontend/craco.config.js (5000).
CORS_ORIGINS=http://localhost:5000

# Upload storage, relative to the backend working directory.
UPLOADS_DIR=uploads
MAX_EBOOK_BYTES=52428800
MAX_CSV_BYTES=10485760
MAX_PHOTO_BYTES=5242880
